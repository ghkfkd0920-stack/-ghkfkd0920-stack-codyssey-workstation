## ubuntu 컨테이너: 일회성 명령 (실행 후 바로 종료)

$ docker run --rm ubuntu:22.04 bash -c "ls / && echo hello from ubuntu && cat /etc/os-release | head -2"
bin
boot
dev
etc
home
lib
media
mnt
opt
proc
root
run
sbin
srv
sys
tmp
usr
var
hello from ubuntu
PRETTY_NAME="Ubuntu 22.04.5 LTS"
NAME="Ubuntu"

## ubuntu 컨테이너: 백그라운드 유지 + exec 로 내부 명령

$ docker run -d --name ubuntu-keep ubuntu:22.04 sleep infinity
5ac1fc3ab8773bad7b0c3ed7551d1cf24e2c7830e155132b41f4e9cc9c0ed7fd

$ docker exec ubuntu-keep bash -c "echo inside container && ls /home && hostname"
inside container
5ac1fc3ab877

$ docker ps
CONTAINER ID   IMAGE          COMMAND            CREATED        STATUS                  PORTS     NAMES
5ac1fc3ab877   ubuntu:22.04   "sleep infinity"   1 second ago   Up Less than a second             ubuntu-keep

## 운영: 로그 / 리소스

$ docker logs hello | head -5

Hello from Docker!
This message shows that your installation appears to be working correctly.

To generate this message, Docker took the following steps:

$ docker stats --no-stream
CONTAINER ID   NAME          CPU %     MEM USAGE / LIMIT   MEM %     NET I/O        BLOCK I/O   PIDS
5ac1fc3ab877   ubuntu-keep   0.00%     940KiB / 3.893GiB   0.02%     1.37kB / 84B   0B / 0B     1

## 중지 / 전체 목록

$ docker stop ubuntu-keep
ubuntu-keep

$ docker ps -a
CONTAINER ID   IMAGE          COMMAND            CREATED          STATUS                                PORTS     NAMES
5ac1fc3ab877   ubuntu:22.04   "sleep infinity"   13 seconds ago   Exited (137) Less than a second ago             ubuntu-keep
840b5e53b432   hello-world    "/hello"           14 seconds ago   Exited (0) 12 seconds ago                       hello

## 정리

$ docker rm hello ubuntu-keep
hello
ubuntu-keep

