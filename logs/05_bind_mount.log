# 05_bind_mount  (2026-11-05 17:23:44)

## 호스트 디렉토리 준비

$ mkdir -p mount-demo && echo "<h1>BEFORE - bind mount</h1>" > mount-demo/index.html

$ cat mount-demo/index.html
<h1>BEFORE - bind mount</h1>

## 바인드 마운트로 실행 (호스트 ./mount-demo → 컨테이너 /usr/share/nginx/html)

$ docker run -d -p 8083:80 --name bind-web -v "$ROOT/mount-demo":/usr/share/nginx/html my-web:1.0
f04e23b113844ecea8a5c63776013e2cf447c8409eb7718fe5b03fb310666eed

$ docker inspect bind-web --format "{{range .Mounts}}{{.Type}}: {{.Source}} -> {{.Destination}}{{end}}"
bind: /Users/ihwarang/Desktop/codyssey-workstation/mount-demo -> /usr/share/nginx/html

## 변경 전 응답

$ curl -s http://localhost:8083
<h1>BEFORE - bind mount</h1>

## 호스트에서 파일 수정 (컨테이너 재시작/재빌드 없음)

$ echo "<h1>AFTER - edited on host at $(date +%H:%M:%S)</h1>" > mount-demo/index.html

## 변경 후 응답

$ curl -s http://localhost:8083
<h1>AFTER - edited on host at 17:24:53</h1>

## 반대 방향: 컨테이너에서 만든 파일이 호스트에 보이는지

$ docker exec bind-web sh -c "echo created-in-container > /usr/share/nginx/html/from_container.txt"

$ ls -l mount-demo && cat mount-demo/from_container.txt
total 16
-rw-rw-rw-@ 1 ihwarang  staff  21 11월  5 17:24 from_container.txt
-rw-r--r--@ 1 ihwarang  staff  44 11월  5 17:24 index.html
created-in-container

## 읽기 전용(:ro) 마운트 시 컨테이너 쓰기 실패 관찰 → 트러블슈팅 3

$ docker rm -f bind-web
bind-web

$ docker run -d --name bind-web -v "$ROOT/mount-demo":/usr/share/nginx/html:ro my-web:1.0
ea932297201382e111609763bc4d629d4bd374c63c0f6c2ba051fe1af03210ab

$ docker exec bind-web sh -c "echo x > /usr/share/nginx/html/x.txt"
sh: can't create /usr/share/nginx/html/x.txt: Read-only file system

$ docker rm -f bind-web
bind-web

